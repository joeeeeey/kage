    "search_max_pages": 2,
    "max_api_calls_per_cycle": 20,
    "delegate_bot_names": [],
    "inbox_task": "owner-inbox",
    "oncall_task": "owner-oncall",
    "inbox_provider": "claude",
    "inbox_model": "claude-sonnet-5-5",
    "inbox_effort": "xhigh",
    "oncall_provider": "codex",
    "oncall_model": "gpt-6.1-sol",
    "oncall_effort": "xhigh"
  },
  "ask": {
    "remind_after": "10h",
    "expire_after": "24h"
  },
  "dispatch": {
    "enabled": false,
    "install_hold": false,
    "concurrency": 3,
    "reserved_intake_slots": 1,
    "liveness_cache_seconds": 20,
    "retry_backoff_seconds": [
      30,
      120
    ],
    "partial_retries": 1,
    "max_run_seconds": 7200,
    "unbound_watches": "revive",
    "notify_cards": true,
    "failed_cooldown_seconds": 1800,
    "max_event_age_hours": 48,
    "provider_wait_hours": 48,
    "probe_min_seconds": 120,
    "probe_max_seconds": 1800,
    "probe_enabled": true,
    "unresolved_retries": 2,
