      "inbox": {
        "skills": "names",
        "git_context": false,
        "rules_in_system_prompt": true,
        "cache_ttl": "1h",
        "keep_skills": [],
        "first_message": "constant",
        "auto_memory": false,
        "mcp": "none",
        "drop_tools": [
          "Agent",
          "Workflow",
          "SendMessage",
          "ListAgents",
          "CronCreate",
          "CronDelete",
          "CronList",
          "ScheduleWakeup",
          "EnterWorktree",
          "ExitWorktree",
          "NotebookEdit",
          "LSP",
          "ReportFindings"
        ]
      },
      "oncall": {
        "skills": "names",
        "git_context": true,
        "rules_in_system_prompt": true,
        "cache_ttl": "1h",
        "keep_skills": [],
        "first_message": "constant",
        "auto_memory": false,
        "mcp": "none",
        "drop_tools": [
          "Workflow",
          "SendMessage",
          "ListAgents",
          "CronCreate",
          "CronDelete",
          "CronList",
          "ScheduleWakeup",
          "EnterWorktree",
          "ExitWorktree",
          "NotebookEdit",
          "ReportFindings"
        ]
      },
      "long_lived": {
        "skills": "full",
        "git_context": true,
        "rules_in_system_prompt": true,
        "cache_ttl": "default",
        "keep_skills": [],
        "first_message": "per_run",
        "auto_memory": true,
        "mcp": "inherit",
        "drop_tools": []
      },
      "task": {
        "skills": "full",
        "git_context": true,
        "rules_in_system_prompt": false,
        "cache_ttl": "default",
        "keep_skills": [],
        "first_message": "per_run",
        "auto_memory": true,
        "mcp": "inherit",
        "drop_tools": []
      }
    }
  },
  "rules": {
    "enabled": true,
    "proposals_enabled": false,
    "proposal_suppress_days": 28,
    "max_proposals_per_run": 5,
    "typed_approval_max_age_hours": 24
  },
  "routines": {
    "enabled": false,
    "min_interval_minutes": 15,
    "max_per_task": 20,
    "max_runs_per_day": 48,
    "scan_seconds": 60
  },
  "blockers": {
    "enabled": true,
    "skill_proposals_enabled": true,
    "reminder_hours": 24,
    "skill_proposal_suppress_days": 28,
    "max_skill_proposals_per_run": 3
  },
  "cards": {
    "retire_buttons_on_reply": true,
    "thread_reply_decisions": true,
    "read_receipts": true,
    "open_poll_seconds": 300,
    "task_thread": true,
    "realtime_replies": false,
    "reconcile_days": 14,
    "reconcile_minutes": 45,
    "thread_retire_hours": 48,
    "retire_on": "plan_change",
    "max_open_per_task": 3
  },
  "tasks": {
    "orphan_sweep_enabled": true,
    "deadline_watchdog_enabled": true,
    "orphan_idle_hours": 12,
    "deadline_lead_hours": 24,
    "sweep_interval_minutes": 30,
    "max_wakes": 6,
    "wake_window_hours": 168,
    "stale_card_days": 3
  },
  "feedback_learning": {
    "enabled": false,
    "strong_signal_mode": "conservative",
    "max_promote_cards_per_day": 0,
    "suppress_days": 28
