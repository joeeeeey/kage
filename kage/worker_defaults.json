{
  "schema_version": 1,
  "providers": {
    "claude": {
      "model_default": "claude-sonnet-5-5",
      "model_important": "claude-opus-5-5",
      "effort": "xhigh",
      "yolo_args": [
        "--permission-mode",
        "bypassPermissions"
      ]
    },
    "codex": {
      "model": "gpt-6.1-sol",
      "effort": "xhigh",
      "yolo_args": [
        "--dangerously-bypass-approvals-and-sandbox"
      ]
    }
  },
  "routing": {
    "categories": {
      "infra": "codex",
      "debug": "codex",
      "dev": "codex",
      "docs": "claude",
      "design": "claude",
      "ui": "claude"
    },
    "fallback_order": [
      "codex",
      "claude"
    ]
  },
  "circuit_breaker": {
    "round_trips_per_hour": 10
  },
  "intake": {
    "enabled": false,
    "channels": [],
    "oncall_channels": [],
    "burst_seconds": 30,
    "poll_seconds": 60,
    "alert_dedupe_minutes": 30,
    "dm_settle_seconds": 90,
    "dm_request_routing": false,
    "dm_conversation_minutes": 30,
    "dm_queries": [],
