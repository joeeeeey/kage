{
  "language": "en",
  "patterns": {
    "card.decision": "(?i)[?]|\\b(?:approve|merge|choose|decide|whether|should|allow|which|give up)\\b",
    "card.filler": "(?i)\\b(?:blocked|stuck|help|please|fyi|decide|approve|handle|look|take a look)\\b|[\\s\\W_]",
    "card.wait": "(?i)\\bwait",
    "card.since": "(?i)\\d{1,2}:\\d{2}|\\d{1,4}[-/.]\\d{1,2}|\\d+\\s*(?:min|minutes?|h\\b|hours?|days?|weeks?|months?)|\\b(?:since|ago|yesterday|today|tonight|this morning|last week|monday|tuesday|wednesday|thursday|friday|saturday|sunday)\\b",
    "card.addressed_to_owner": "\\byou\\b",
    "card.failure": "(?i)unauthori[sz]ed|forbidden|\\b40[13]\\b|permission denied|access denied|not authori[sz]ed|timed?[ -]?out|invalid[_ ]token|token (?:expired|invalid)",
    "card.infra_apply": "(?i)apply-approved|make\\s+apply|(?:terraform|tofu|terragrunt)\\s+apply|saved[- ]?plan|apply.{0,24}(?:plan|terraform|tofu|root)|(?:plan|terraform|tofu|root).{0,24}apply",
    "registry.title_script": "[A-Za-z]",
    "secret.labelled": "(?i)\\b(?:password|passwd|pwd|secret|api[_-]?key|token)\\s*[:=]\\s*[^\\s<]{6,}",
    "decision.condition": "(?i)^(?:but|except|only|unless|however|instead)(?![a-z])",
    "decision.question": "[?]",
    "decision.plan_change": "(?i)\\b(?:change (?:it )?to|switch to|instead|cancel|stop|hold off|pause|only do|wait (?:until|for))\\b",
    "decision.asking": "(?i)[?]|\\b(?:what|why|how|whether|should|can we|could we)\\b"
  },
