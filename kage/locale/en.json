{
  "language": "en",
  "patterns": {
    "card.decision": "(?i)[?]|\\b(?:approve|merge|choose|decide|whether|should|allow|which|give up)\\b",
    "card.filler": "(?i)\\b(?:blocked|stuck|help|please|fyi|decide|approve|handle|look|take a look)\\b|[\\s\\W_]",
    "card.wait": "(?i)\\bwait",
    "card.since": "(?i)\\d{1,2}:\\d{2}|\\d{1,4}[-/.]\\d{1,2}|\\d+\\s*(?:min|minutes?|h\\b|hours?|days?|weeks?|months?)|\\b(?:since|ago|yesterday|today|tonight|this morning|last week|monday|tuesday|wednesday|thursday|friday|saturday|sunday)\\b",
    "card.addressed_to_owner": "\\byou\\b",
    "card.failure": "(?i)unauthori[sz]ed|forbidden|\\b40[13]\\b|permission denied|access denied|not authori[sz]ed|timed?[ -]?out|invalid[_ ]token|token (?:expired|invalid)",
    "card.infra_apply": "(?i)apply-approved|make\\s+apply|(?:terraform|tofu|terragrunt)\\s+apply|saved[- ]?plan|apply.{0,24}(?:plan|terraform|tofu|root)|(?:plan|terraform|tofu|root).{0,24}apply",
    "registry.title_script": "[A-Za-z]"
  },
  "messages": {
    "you": "you",
    "card.line.situation": "Situation: {text}",
    "card.line.checked": "Checked: {text}",
    "card.list_separator": "; ",
    "card.line.field": "{label}: {text}",
    "card.pr.pr_cause": "Cause",
    "card.pr.pr_why": "Why this way",
    "card.pr.pr_change": "What changes",
    "card.pr.pr_verify": "How to verify after merge",
    "card.plan.plan_pr": "PR",
    "card.plan.plan_root": "root",
    "card.plan.plan_resources": "resources",
    "card.plan.plan_counts": "C/U/D/R",
    "card.line.plan": "Plan: {pr} · root {root}",
    "card.line.resources": "Resources: {resources}",
    "card.line.create_update": "Create {create} · Update {update}",
    "card.line.delete_replace": "Delete {delete} · Replace {replace}",
    "card.apply_line": "Once you approve this plan, the agent runs the saved-plan apply; a changed plan is asked again.",
    "registry.level.L0": "constitution (judgement)",
    "registry.level.L1": "task-class playbook",
    "registry.level.L2": "hint at action time",
    "registry.level.L3": "refused by code",
    "registry.level.L4": "credential boundary",
    "registry.status.active": "active",
    "registry.status.draft": "draft",
    "registry.status.retired": "retired",
    "registry.how": "{level} ({guard}): {actions}",
    "registry.actions_separator": ", ",
    "registry.why_separator": "; ",
    "registry.show.head": "Rules ({where}: {dir})",
    "registry.show.where_live": "live directory",
    "registry.show.where_seed": "the shipped seed",
    "registry.show.rule": "{id} {title} · {status}\n  How it is checked: {how}\n  Why: {why}",
    "registry.problem.title": "title must be one line"
  }
}
